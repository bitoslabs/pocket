{
  "name": "zapjournal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Private journal and Lightning sats tracker on Nostr (pure web app)",
  "scripts": {
    "check": "node scripts/check-precache.mjs",
    "test": "node scripts/check-precache.mjs && node --test",
    "icons": "node scripts/generate-icons.mjs",
